/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    andersenlab/nemascan-nf Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

params {
    timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    traits                 = null
    species                = 'c_elegans'
    mapping                = true
    finemapping            = true
    mediation              = false
    transcript_eqtl        = null
    transcript_expression  = null
    genes                  = null
    skip_pruning           = true
    summarization_method   = "mean"
    maf                    = 0.05
    pca                    = false
    snp_grouping           = 1000
    ci_size                = 150
    significance_threshold = "BF"
    sparse_cut             = 0.05
    alpha                  = 0.05
    gwa_method             = "both"
    highlight_strains      = ""
    skip_report            = false
    file_paths = [
        'c_elegans': [
            'vcf': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_elegans/20250625/variation/WI.20250625.small.hard-filter.isotype.vcf.gz",
            'imputed': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_elegans/20250625/variation/WI.20250625.impute.isotype.vcf.gz",
            'annotation': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_elegans/20250625/annotation/WI.20250625.csq.strain-annotation.csv.gz",
            'haplotypes': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_elegans/20250625/haplotype/haplotype_df_isotype.bed",
            'genes': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_elegans/20250625/browser_tracks/20250625_c_elegans_transcripts.bed.gz",
            'isogroups': "https://caendr.org/request-strains/isotype_list/download"
            ],
        'c_briggsae': [
            'vcf': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_briggsae/20250626/variation/WI.20250626.small.hard-filter.isotype.vcf.gz",
            'imputed': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_briggsae/20250626/variation/WI.20250626.impute.isotype.vcf.gz",
            'annotation': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_briggsae/20250626/annotation/WI.20250626.csq.strain-annotation.csv.gz",
            'haplotypes': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_briggsae/20250626/haplotype/haplotype_df_isotype.bed",
            'genes': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_briggsae/20250626/browser_tracks/20250626_c_briggsae_transcripts.bed.gz",
            'isogroups': "https://caendr.org/request-strains/isotype_list/download"
            ],
        'c_tropicalis': [
            'vcf': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_tropicalis/20250627/variation/WI.20250627.small.hard-filter.isotype.vcf.gz",
            'imputed': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_tropicalis/20250627/variation/WI.20250627.impute.isotype.vcf.gz",
            'annotation': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_tropicalis/20250627/annotation/WI.20250627.csq.strain-annotation.csv.gz",
            'haplotypes': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_tropicalis/20250627/haplotype/haplotype_df_isotype.bed",
            'genes': "https://caendr-open-access-data-bucket.s3.us-east-2.amazonaws.com/dataset_release/c_tropicalis/20250627/browser_tracks/20250627_c_tropicalis_transcripts.bed.gz",
            'isogroups': "https://caendr.org/request-strains/isotype_list/download"
            ],
        ].withDefault { null }
    vcf = params.file_paths[params.species]['vcf']
    vcf_index = params.vcf + ".tbi"
    imputed = params.file_paths[params.species]['imputed']
    imputed_index = params.imputed + ".tbi"
    annotation = params.file_paths[params.species]['annotation']
    haplotypes = params.file_paths[params.species]['haplotypes']
    genes = params.file_paths[params.species]['genes']
    isogroups = params.file_paths[params.species]['isogroups']

    // Boilerplate options
    publish_dir_mode       = 'copy'
    monochrome_logs        = false
    version                = false

    // GCP-only params
    google_project               = null
    google_zone                  = null
    google_service_account_email = null
    git_info                     = null
    work_dir                     = null

    // Config options
    // config_profile_name: String    = null
    // config_profile_description: String = null

    // custom_config_version: String  = 'master'
    // custom_config_base: Path       = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    // config_profile_contact: String = null
    // config_profile_url: Path       = null
    validate_params        = true
}


profiles {
    debug {
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test          { includeConfig 'conf/test.config'      }
    test_rockfish { includeConfig 'conf/test_rockfish.config' }
    rockfish      { includeConfig 'conf/rockfish.config'  }
    gcp           { includeConfig 'conf/gcp.config'  }
    standard      { includeConfig 'conf/rockfish.config'  }
}
// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load andersenlab/fq-processing-nf custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load andersenlab/fq-processing-nf custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/fq-processing-nf.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
// apptainer.registry    = 'quay.io'
// docker.registry       = 'quay.io'
// podman.registry       = 'quay.io'
// singularity.registry  = 'quay.io'
// charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    // "-o",         // Returns the status of the last command to exit..
    // "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

// Enable module-specific script execution
nextflow.enable.moduleBinaries = true

outputDir = "nemascan_${new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')}"

timeline {
    enabled = true
    file    = "execution_timeline_${params.timestamp}.html"
}
report {
    enabled = true
    file    = "execution_report_${params.timestamp}.html"
}
trace {
    enabled = true
    file    = "pipeline_info/execution_trace_${params.timestamp}.txt"
}
dag {
    enabled = true
    file    = "pipeline_info/pipeline_dag_${params.timestamp}.html"
}

manifest {
    name            = 'andersenlab/nemascan-nf'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Michael Sauria',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/andersenlab/nemascan-nf'
    description     = """A nextflow for performing one or more genome-wide association analyses"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=26.04.0'
    version         = '1.0.0dev'
    doi             = ''
}



// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
